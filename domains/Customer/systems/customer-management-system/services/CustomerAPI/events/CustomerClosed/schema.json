{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomerClosed",
  "description": "Emitted when a customer closes their account",
  "type": "object",
  "properties": {
    "eventId": {
      "description": "Unique identifier for this event",
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "description": "Time the account was closed",
      "type": "string",
      "format": "date-time"
    },
    "customerId": {
      "description": "Unique identifier for the customer whose account was closed",
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "description": "Why the account was closed",
      "type": "string",
      "enum": ["CUSTOMER_REQUEST", "FRAUD", "INACTIVITY"]
    }
  },
  "required": ["eventId", "occurredAt", "customerId", "reason"]
}
